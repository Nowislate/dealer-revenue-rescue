# Every text file is LF in the checkout on every OS, so a Windows build
# of the release zip has the same bytes (and SHA-256) as a Linux build.
# Later lines override this one.
* text=auto eol=lf
# Preserve the supplied UTF-8/BOM + CRLF source documents byte-for-byte.
docs/specs/native-safety-brief-2026-11-12-v1.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/specs/native-safety-source-2026-11-12-v1.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/fixtures/form_images/*.jpg binary
tests/fixtures/values_only/*.pdf binary
# Windows batch files run with CRLF line endings.
*.cmd text eol=crlf
src/dealerpaperwork/demo_forms/**/*.jpg binary
